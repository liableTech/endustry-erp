{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "erp-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        ".\\run-backend.cmd"
      ],
      "port": 8080
    },
    {
      "name": "erp-frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}